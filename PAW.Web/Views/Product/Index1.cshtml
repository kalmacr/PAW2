@model IEnumerable<PAW.Models.DTO.ProductDTO>


@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-box"></i> Product Administration
            </h3>

            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus-circle"></i> Add New Product
            </a>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Product ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Rating</th>
                            <th>Created By</th>
                            <th>Modified By</th>
                            <th>Created Date</th>
                            <th>Modified Date</th>
                            <th width="220">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProductId</td>
                                <td>
                                    <strong>@item.Name</strong>
                                </td>

                                <td>
                                    @(item.Description?.Length > 50
                                        ? item.Description.Substring(0, 50) + "..."
                                        : item.Description)
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        @item.Rating ★
                                    </span>
                                </td>

                                <td>@item.CreatedBy</td>

                                <td>@item.ModifiedBy</td>

                                <td>
                                    @item.CreateData.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @item.ModifiedData.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info text-white">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning text-dark">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger">
                                            <i class="fas "></i>
                                        </a>

                                    </div>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer bg-light">
            <small>Total Products: <b>@Model.Count()</b></small>
        </div>

    </div>

</div>
